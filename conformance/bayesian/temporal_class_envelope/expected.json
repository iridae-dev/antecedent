{
  "schema_version": 1,
  "case": "temporal_class_envelope_bayesian",
  "columns": ["t", "y", "z"],
  "n": 800,
  "n_draws": 64,
  "seed": 7,
  "law": "z alternates 0/1; t = 0.3 + 0.4 z + 0.05 sin(0.017 i); y = 1 + 2 t_{i-1} + 0.5 z_{i-1}",
  "query": {
    "treatment": "t",
    "outcome": "y",
    "treatment_offset": -1,
    "horizon_steps": 1,
    "active_level": 1.0,
    "control_level": 0.0
  },
  "class_prior_ordered": [0.3, 0.7],
  "cpdag": {
    "directed": [["z", 1, "y", 0], ["t", 1, "y", 0]],
    "undirected": [["z", 1, "t", 1]],
    "identification": {
      "identifier": "generalized.adjustment",
      "status": "PartiallyIdentified",
      "completion_count": 2
    }
  },
  "assertions": {
    "without_class_prior": {
      "weight_basis": "completion_enumeration",
      "posterior_attached": false,
      "primary_ate_finite": false,
      "diagnostic": "estimate.temporal_class.enumeration_not_probability"
    },
    "with_class_prior": {
      "weight_basis": "caller_supplied_class_prior",
      "posterior_attached": true,
      "primary_ate_finite": true,
      "unidentified_mass": 0.0,
      "absolute_tolerance": 0.25
    }
  },
  "multi_step": {
    "law": "y = 1 + 2 t_{i-1} + 3 t_{i-2}",
    "window": [-2, -1],
    "last_step_effect": 2.0,
    "full_window_effect": 5.0,
    "absolute_tolerance": 0.35
  }
}
