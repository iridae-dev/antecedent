{
  "schema_version": 2,
  "oracle": {
    "project": "clean-room brute-force expected-utility enumeration",
    "algorithm": "enumerate action/outcome utility and constraint matrices in exact rational arithmetic; choose the Bayes action over admissible actions only; regret is the expected opportunity loss of the Bayes action against perfect information over admissible actions (EVPI)",
    "pin": "fixture-algorithm-v2",
    "python": "3.11.5",
    "command": "python3 antecedent_design_oracle_v2.py",
    "generation_location": "temporary external harness; deleted after artifact import",
    "dependencies": "Python standard library only (fractions, json)"
  },
  "normalization": {
    "tie_break": "lowest action index",
    "admissible": "minimum constraint satisfaction plus 1e-12 is at least chance_threshold",
    "regret": "mean over outcomes of (max admissible utility minus utility of the Bayes action)",
    "no_admissible_action": "typed refusal (DesignError::NoAdmissibleAction); no expected utility or regret is reported",
    "empty_outcomes": "typed refusal (DesignError::Shape); excluded from this fixture"
  },
