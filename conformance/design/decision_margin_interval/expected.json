  "schema_version": 2,
  "scope": "Delta-method sampling interval of a derived decision margin (a function of arm component means) at four hand cases: cluster and complete designs with separate arm covariances, matched-pair and switchback designs with one covariance of both arms' means.",
  "tolerance": {
    "relative": 1e-10
  },
  "oracle": {
    "kind": "closed_form",
    "project": "closed-form first-order delta method with exact rational arithmetic",
    "method": "forward-mode gradient of the margin expression over Fractions, exact quadratic form g'Sg, normal quantile from the standard library, Student quantile from the finite-sum CDF for odd degrees of freedom",
    "generator": "conformance/design/decision_margin_interval/reference.py",
    "command": "uv run --frozen --script conformance/design/decision_margin_interval/reference.py --check",
    "environment_lock": "conformance/design/decision_margin_interval/reference.py.lock",
    "generator_retained": true,
    "limitations": "Hand-constructed covariances; the interval is the first-order sampling interval and carries no coverage claim.",
    "independence_basis": "The generator differentiates the margin expression forward-mode over exact Fractions at each arm's means, sums the quadratic form h' S h exactly (separate arm covariances, or the joint 2K-by-2K covariance with the control gradient negated), and takes one square root in 60-digit Decimal. The normal critical value is the standard library's inverse normal CDF; the Student critical value with 29 degrees of freedom is the root of the closed finite-sum CDF for odd degrees of freedom, found by bisection. It imports no Antecedent code, draws nothing and calls no decision routine. The executing assertion builds the same evidence and derived quantity through the public constructors and compares what derive reports.",
    "asserted_outputs": [
      "cases[*].expected.estimate",
      "cases[*].expected.standard_error",
      "cases[*].expected.lower and upper",
      "cases[*].expected.critical_value (as the interval half-width over the standard error)"
    ],
    "context_only_outputs": [
      "cases[*].components, inputs, expression, means, dependence and design (inputs)"
    ],
    "executing_assertion": "crates/antecedent/tests/decision_evidence_workflow.rs::the_margin_interval_equals_the_independent_delta_method_truth",
