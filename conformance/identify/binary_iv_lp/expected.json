  "oracle": {
    "kind": "independent_reimplementation",
    "project": "SciPy HiGHS linear programming over the 16 binary-IV response types",
    "version": "scipy 1.14.1 with numpy 2.1.3",
    "generator": "conformance/identify/binary_iv_lp/reference.py",
    "command": "uv run --frozen --script conformance/identify/binary_iv_lp/reference.py --check",
    "environment_lock": "conformance/identify/binary_iv_lp/reference.py.lock",
    "generator_retained": true,
    "asserted_outputs": [
      "sharp lower and upper bound on E[Y(1)-Y(0)] without monotonicity",
      "feasibility verdict (instrumental inequality)"
    ],
    "reference_review": {
      "scope": "Thirty-two fixed laws: the Balke-Pearl Table 1 law, five analytic/degenerate laws, two inequality-violating laws and 24 seeded random laws drawn from random response-type distributions. Bounds and verdicts are compared at absolute 1e-8 with the product's exact response-type optimizer.",
      "independence_basis": "The generator states the binary-IV model itself (four response functions per latent type, exclusion and exogeneity by a single type distribution shared across instrument arms) and solves the resulting linear program with a simplex/interior-point solver, a different algorithm from the product's enumeration of basic solutions. It imports no Antecedent code and no causal-inference package. The shared object is the model statement: a mistake in the 16-type encoding common to both would not be detected here, which is why the Balke-Pearl Table 1 law is also pinned to the independent bpbounds values (-0.1946, 0.0054) that the LP reproduces.",
      "historical_exposure": "Authored in this repository after reading the product's constraint construction in order to review it; the encoding was written independently as named tuples and not copied. No upstream implementation or test source was consulted.",
      "redistribution": "Repository-authored MIT OR Apache-2.0 generator and deterministic inputs. SciPy and NumPy are tooling dependencies in an isolated locked script environment, outside the product and ordinary CI.",
      "limitations": "Binary instrument, treatment and outcome; exact finite laws only. No sampling uncertainty, weak-instrument behavior, covariates, weights or missingness. Infeasibility cases violate the instrumental inequality by large margins (L1 slack 1.2 and 2.0); behavior within the product's 1e-7 feasibility tolerance is a declared numerical policy, not compared. Calibration remains deferred.",
      "sources": [
        "https://docs.scipy.org/doc/scipy-1.14.1/reference/generated/scipy.optimize.linprog.html",
        "https://doi.org/10.1080/01621459.1997.10474074"
      ],
