# Temporal counterfactual facades exclusively execute/replay the mechanism model.
mechanism crates/antecedent/src/analysis/temporal_counterfactual.rs
# Public module declaration only; calls remain inside the mechanism facade.
allow mechanism crates/antecedent/src/analysis/mod.rs temporal_counterfactual transported_counterfactual
# Artifact replay invokes only the named temporal mechanism evaluator.
allow mechanism crates/antecedent-io/src/temporal_counterfactual_artifact.rs ARTIFACT_KIND Canon FactualUnitHistory HistoryId MAX_UNITS MECHANISM_CLASS META_SECTION MechanismWire NamedActionHistory NodeMechanism RefusalWire RefusingWitness SharedAbductionReceipt SnapshotId TemporalCounterfactualError TemporalCounterfactualResult TemporalCounterfactualSpec TemporalGraph TemporalMechanismFit TemporalNode UnitId VersionPeek antecedent_counterfactual decode_parts encode_parts evaluate_temporal_counterfactual from_core identity_diff identity_of invalid temporal_cross_world
key mechanism query Counterfactual AnomalyAttribution ChangeAttribution MechanismChange UnitChange
key mechanism estimator gcm.*
# The dispatch arm of AnalysisRoute::ChangeAttribution, and the NestedCounterfactual
# arm, which executes the prepared gcm::NestedCounterfactualOperation (or compiles
# one for an unprepared query): exactly the `key` queries.
allow mechanism crates/antecedent/src/analysis/execute/dispatch.rs ChangeAttribution NestedCounterfactualOperation compile gcm nested_counterfactual
# Sibling re-exports of the gcm entry points and the checked counterfactual /
# attribution operation types; every caller is checked by name.
allow mechanism crates/antecedent/src/analysis/execute/mod.rs CheckedAttributionOperation CheckedCounterfactualPlan CounterfactualProcedure SelectionDiagram anomaly_attribution_query_with attribute_distribution_change attribute_unit_change attribution_path checked_attribution counterfactual_ite fit_gcm gcm map_mechanism_fit mechanism_change_detection
# CausalQuery::ChangeAttribution: the query enum variant named when a compiled
# plan is labelled with its gcm identifier.
allow mechanism crates/antecedent/src/analysis/execute/compile.rs ChangeAttribution
# The contract's nested counterfactual fit snapshot, built only when the prepared
# analysis retains a gcm::NestedCounterfactualOperation (the NestedCounterfactual
# `key` query); every other contract leaves the slot empty.
allow mechanism crates/antecedent/src/analysis/contract.rs NestedCounterfactualOperation gcm result_digest
# Result slots and payload enum variants holding the facet's outputs (types only).
allow mechanism crates/antecedent/src/analysis/execute/execute_helpers.rs AnomalyScores ChangeAttribution ChangeAttributionResult IteResult MechanismChangeDetection UnitChangeResult antecedent_attribution gcm unit_change
allow mechanism crates/antecedent/src/analysis/helpers.rs AnomalyScores ChangeAttributionResult IteResult MechanismChangeDetection UnitChangeResult antecedent_attribution gcm unit_change
allow mechanism crates/antecedent/src/result.rs AnomalyScores ChangeAttributionResult IteResult MechanismChangeDetection UnitChangeResult antecedent_attribution gcm unit_change
# CausalQuery::ChangeAttribution / a `unit_change` field: core names the facet shares.
# Preparation also compiles and retains the checked counterfactual, nested
# counterfactual and attribution operations for the Counterfactual,
# NestedCounterfactual, AnomalyAttribution and ChangeAttribution `key` queries;
# a plan for any other query never constructs them.
allow mechanism crates/antecedent/src/analysis/prepared.rs ChangeAttribution CheckedAttributionOperation CheckedCounterfactualOperation CheckedCounterfactualPlan CounterfactualProcedure NestedCounterfactualOperation compile evaluate gcm nested_counterfactual unit_change
allow mechanism crates/antecedent/src/support.rs ChangeAttribution
# Cross-world (nested counterfactual) facade evaluation: drives the counterfactual engine over
# a compiled model; it is not itself a mechanism-fit path, so it is allowed by name here.
allow mechanism crates/antecedent/src/cross_world.rs BasisTerm CompiledCausalModel CounterfactualEngine CounterfactualError MechanismSlot NestedCounterfactualOperation NestedOutcomeMechanism NoiseInferenceKind ParentBasis Product antecedent_counterfactual antecedent_model check_bounds cross_world evaluate_cross_world fit_nested_mechanisms fit_nested_mechanisms_polled gcm invalid
# `From` conversions of the facet crates' error types.
allow mechanism crates/antecedent/src/error.rs AttributionError CounterfactualError ModelError antecedent_attribution antecedent_counterfactual antecedent_model
# `pub mod gcm;`.
allow mechanism crates/antecedent/src/lib.rs gcm
# Model-bundle byte encode / decode API: runs only when a caller saves or loads
# a fitted model, never inside a Study execution.
allow mechanism crates/antecedent/src/io.rs ModelBundle ModelBundleEncode decode_model_bundle encode_model_bundle
allow mechanism crates/antecedent-io/src/lib.rs MechanismSlotWire MechanismStoreWire ModelBundle ModelBundleEncode ModelBundleHeaderWire ModelKindWire decode_model_bundle encode_model_bundle mechanism_wire mechanisms_from_wire mechanisms_to_wire model_bundle result_digest transported_counterfactual_artifact
# ArtifactKind::ModelBundle: an enum variant the facet shares by name.
allow mechanism crates/antecedent-io/src/wire.rs ModelBundle

