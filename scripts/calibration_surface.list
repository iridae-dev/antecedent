# The statistical surface: every path whose contents can move a number in
# parity/coverage_records.toml, and the facet each belongs to.
#
# A record stands until the surface it measured changes. It is attested while
# no path in a facet it depends on differs between the commit it was measured
# at (its calibration_sha) and HEAD; scripts/calibration_facets.py derives
# each record's facets from the record itself and computes the drift.
#
#   <facet> <path>     A path ending in "/" covers everything under it. A file
#                      belongs to the facet of the longest line that covers it.
#   core               Every record depends on it: a change invalidates every
#                      record. Paths no narrower line claims are core.
#   other facets       A change invalidates only the records carrying the facet.
#   key <facet> <field> <pattern>...
#                      Records whose field matches a pattern carry the facet.
#   allow <facet> <path> <name>...
#                      A reviewed reference from a file outside the facet to
#                      the facet's items, which cannot run the facet's code for
#                      records that do not carry it. Any other reference, and
#                      any stale name here, fails `calibration_facets.py check`.
#
# Cargo.toml / Cargo.lock are compared with workspace version numbers removed:
# a release bump is not interval theory, but a feature, profile or external
# dependency change is.

# ---- core: toolchain, manifests, shared libraries, the harness -------------
core Cargo.toml
core Cargo.lock
core rust-toolchain.toml
core crates/antecedent/Cargo.toml
core crates/antecedent-attribution/Cargo.toml
core crates/antecedent-core/Cargo.toml
core crates/antecedent-counterfactual/Cargo.toml
core crates/antecedent-data/Cargo.toml
core crates/antecedent-design/Cargo.toml
core crates/antecedent-discovery/Cargo.toml
core crates/antecedent-estimate/Cargo.toml
core crates/antecedent-expr/Cargo.toml
core crates/antecedent-graph/Cargo.toml
core crates/antecedent-identify/Cargo.toml
core crates/antecedent-io/Cargo.toml
core crates/antecedent-kernels/Cargo.toml
core crates/antecedent-model/Cargo.toml
core crates/antecedent-prob/Cargo.toml
core crates/antecedent-state/Cargo.toml
core crates/antecedent-stats/Cargo.toml
core crates/antecedent-validate/Cargo.toml
core crates/antecedent/src/
core crates/antecedent-core/src/
core crates/antecedent-data/src/
core crates/antecedent-discovery/src/
core crates/antecedent-estimate/src/
core crates/antecedent-expr/src/
core crates/antecedent-graph/src/
core crates/antecedent-identify/src/
core crates/antecedent-io/src/
core crates/antecedent-kernels/src/
core crates/antecedent-prob/src/
core crates/antecedent-state/src/
core crates/antecedent-stats/src/
core crates/antecedent-validate/src/
core crates/antecedent/tests/common/
core scripts/gate_calibration.sh
core scripts/gate_response_calibration.sh

# ---- mechanism: fitted structural causal models (GCM) ----------------------
# Reached only by the queries the dispatch routes to attribution_path.rs.
mechanism crates/antecedent-model/src/
mechanism crates/antecedent-counterfactual/src/
mechanism crates/antecedent-attribution/src/
mechanism crates/antecedent/src/gcm.rs
mechanism crates/antecedent/src/analysis/execute/attribution_path.rs
mechanism crates/antecedent-io/src/mechanism_wire.rs
mechanism crates/antecedent-io/src/model_bundle.rs
key mechanism query Counterfactual AnomalyAttribution ChangeAttribution MechanismChange UnitChange
key mechanism estimator gcm.*
# The five dispatch arms of AnalysisRoute::{Counterfactual, Anomaly,
# ChangeAttribution, MechanismChange, UnitChange}: exactly the `key` queries.
allow mechanism crates/antecedent/src/analysis/execute/dispatch.rs ChangeAttribution execute_anomaly execute_change_attribution execute_counterfactual execute_mechanism_change execute_unit_change
# Sibling re-exports of the gcm entry points; every caller is checked by name.
allow mechanism crates/antecedent/src/analysis/execute/mod.rs anomaly_attribution attribute_distribution_change attribute_unit_change attribution_path counterfactual_ite fit_gcm fit_gcm_counterfactual gcm map_mechanism_fit mechanism_change_detection
# Result slots and payload enum variants holding the facet's outputs (types only).
allow mechanism crates/antecedent/src/analysis/execute/execute_helpers.rs AnomalyScores ChangeAttribution ChangeAttributionResult IteResult MechanismChangeDetection UnitChangeResult antecedent_attribution gcm unit_change
allow mechanism crates/antecedent/src/analysis/helpers.rs AnomalyScores ChangeAttributionResult IteResult MechanismChangeDetection UnitChangeResult antecedent_attribution gcm unit_change
allow mechanism crates/antecedent/src/result.rs AnomalyScores ChangeAttributionResult IteResult MechanismChangeDetection UnitChangeResult antecedent_attribution gcm unit_change
# CausalQuery::ChangeAttribution / a `unit_change` field: core names the facet shares.
allow mechanism crates/antecedent/src/analysis/prepared.rs ChangeAttribution unit_change
allow mechanism crates/antecedent/src/support.rs ChangeAttribution
# `From` conversions of the facet crates' error types.
allow mechanism crates/antecedent/src/error.rs AttributionError CounterfactualError ModelError antecedent_attribution antecedent_counterfactual antecedent_model
# `pub mod gcm;`.
allow mechanism crates/antecedent/src/lib.rs gcm
# Model-bundle byte encode / decode API: runs only when a caller saves or loads
# a fitted model, never inside a Study execution.
allow mechanism crates/antecedent/src/io.rs ModelBundle ModelBundleEncode decode_model_bundle encode_model_bundle
allow mechanism crates/antecedent-io/src/lib.rs MechanismSlotWire MechanismStoreWire ModelBundle ModelBundleEncode ModelBundleHeaderWire ModelKindWire decode_model_bundle encode_model_bundle mechanism_wire mechanisms_from_wire mechanisms_to_wire model_bundle
# ArtifactKind::ModelBundle: an enum variant the facet shares by name.
allow mechanism crates/antecedent-io/src/wire.rs ModelBundle

# ---- design: experiment / measurement design ranking -----------------------
design crates/antecedent-design/src/
design crates/antecedent/src/design.rs
# CausalContract::{preview_rank_designs, rank_designs, rank_designs_bound}: the
# public design-ranking API, never called by a Study execution.
allow design crates/antecedent/src/analysis/contract.rs CandidateDesign DesignEvaluationContext DesignObjective DesignRankPreview DesignRanker DesignRanking design preview_design_rank rank_designs rank_designs_bound
allow design crates/antecedent/src/error.rs DesignError antecedent_design
allow design crates/antecedent/src/lib.rs design

# ---- registry mirrors: generated from parity/*.toml, never measured ---------
# Tables of record rows and reason-code strings. They decide how a result is
# labelled and matched, not any number a coverage test counts.
registry_mirror crates/antecedent-io/src/coverage_records_data.rs
registry_mirror crates/antecedent-core/src/reason_codes_data.rs
allow registry_mirror crates/antecedent-core/src/reason_code.rs REASON_CODES RUNTIME_REFUSAL_CODES
allow registry_mirror crates/antecedent-io/src/calibration.rs CoverageGridPoint CoverageRecord REASON_CODES RECORDS coverage_records_data
allow registry_mirror crates/antecedent-io/src/contract_section.rs CoverageRecord coverage_records_data
allow registry_mirror crates/antecedent-io/src/lib.rs coverage_records_data
allow registry_mirror crates/antecedent/src/lib.rs INTERVAL_METHOD_REASONS RECORDS coverage_records_data

# ---- suites: a suite's own code only reaches the records it emits ----------
suite.calibration_coverage crates/antecedent-estimate/src/calibration_coverage.rs
