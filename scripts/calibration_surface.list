core crates/antecedent-stats/src/adaptive_inference/procedure_repeated_measures.rs
core crates/antecedent-stats/src/adaptive_inference/procedure_simulation.rs
core crates/antecedent-stats/src/adaptive_inference/procedure_uncertainty.rs
core crates/antecedent/src/analysis/adaptive_inference.rs
core crates/antecedent/src/analysis/adaptive_participant_procedure.rs
core crates/antecedent/src/analysis/adaptive_procedure_report.rs

# Measured adaptive intervals: the constructions and calibration keys the harness
# and the public measured route share, so a record describes exactly what is reported.
