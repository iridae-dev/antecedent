{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "cases",
    "status",
    "method",
    "graph_class",
    "structure_version",
    "names",
    "witness_query",
    "treatments",
    "outcome"
  ],
  "properties": {
    "kind": { "type": "string" },
    "cases": { "type": "array" },
    "status": { "type": "string" },
    "method": { "type": "string" },
    "graph_class": { "type": "string" },
    "structure_version": {},
    "names": { "type": "array", "items": { "type": "string" } },
    "witness_query": { "type": "object" },
    "treatments": { "type": "array" },
    "outcome": { "type": "object" },
    "identified_weight": { "type": "number" },
    "unidentified_weight": { "type": "number" },
    "truncated_completions": {},
    "features": { "type": "array" },
    "completion_keys": { "type": "array" }
  }
}
