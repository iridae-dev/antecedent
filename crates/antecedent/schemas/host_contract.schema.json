    "host_status": {
      "type": "string",
      "enum": [
        "supported",
        "partial",
        "unsupported"
      ],
      "description": "What a host may do with a claim or an operation. supported: use it as stated. partial: use only what the record says (an identified set, an open obligation, an unreviewed graph, an unknown domain). unsupported: do not use it; read the refusal."
    },
