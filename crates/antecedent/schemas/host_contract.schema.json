    "error_family": {
      "type": "string",
      "enum": [
        "error",
        "identify",
        "estimate",
        "validate",
        "discovery",
        "model",
        "counterfactual",
        "attribution",
        "data",
        "graph",
        "design",
        "state",
        "serialization",
        "compile",
        "resource",
        "review_required",
        "unsupported",
        "cancelled",
        "type",
        "value",
        "structured_refusal",
        "not_identified"
      ],
      "description": "Stable exception family. The same code names the Rust CausalError class and the Python exception class."
    },
    "claim_kind": {
      "type": "string",
      "enum": [
        "point",
        "bounds",
        "mixture",
        "response",
        "policy_value",
        "refusal",
        "incomplete",
        "associational"
      ],
      "description": "Kind of value a claim carries."
    },
    "domain_status": {
      "type": "string",
      "enum": [
        "identified",
        "supported",
        "evaluated",
        "outside_scope",
        "contradicted",
        "unknown",
        "limited",
        "not_claimed"
      ],
      "description": "Status of one claim domain (identification, support or evaluated)."
    },
    "semantic_applicability": {
      "type": "string",
      "enum": [
        "licensed",
        "unlicensed",
        "impossible",
        "unknown"
      ],
      "description": "Support-matrix applicability of a requested operation."
    },
    "operation_readiness": {
      "type": "string",
      "enum": [
        "executable",
        "review_required",
        "assumption_missing",
        "empirical_check_pending",
        "empirical_support_failed",
        "binding_missing",
        "runtime_unavailable",
        "unknown_support"
      ],
      "description": "Snapshot readiness of an operation. Only executable means ready to run."
    },
    "operation_kind": {
      "type": "string",
      "enum": [
        "inspect",
        "prepare",
        "execute",
        "retarget",
        "rank_designs",
        "export"
      ],
      "description": "Operation a capability report describes."
    },
    "support_cell_status": {
      "type": "string",
      "enum": [
        "licensed",
        "allowed_unlicensed",
        "not_applicable",
        "refused"
      ],
      "description": "Classification of one support-matrix cell."
    },
    "support_query": {
      "type": "string",
      "enum": [
        "AverageEffect",
        "ConditionalEffect",
        "Counterfactual",
        "NestedCounterfactualEffect",
        "InterventionalDistribution",
        "PathSpecificEffect",
        "MediationEffect",
        "TemporalMediationEffect",
        "PulseEffect",
        "SustainedEffect",
        "TemporalConditionalPulse",
        "TemporalConditionalSustained",
        "ResponseCurve",
        "AverageDerivative",
        "PointDerivative",
        "SemiElasticity",
        "Elasticity",
        "DirectionalDerivative",
        "ResponseJacobian",
        "InterventionResponse",
        "TransportQuery",
        "InterferenceQuery",
        "AnomalyAttribution",
        "ChangeAttribution"
      ],
      "description": "Public support-matrix query labels."
    },
    "graph_class": {
      "type": "string",
      "enum": [
        "Dag",
        "Admg",
        "Cpdag",
        "Pag",
        "TemporalDag",
        "TemporalCpdag",
        "TemporalPag",
        "TemporalAdmg",
        "RandomizedTrial"
      ],
      "description": "Graph class of the accepted structure."
    },
    "structure_source": {
      "type": "string",
      "enum": [
        "explicit",
        "accepted",
        "graph_posterior",
        "randomized_trial",
        "discovered"
      ],
      "description": "How the structure was supplied."
    },
    "inference": {
      "type": "string",
      "enum": [
        "frequentist",
        "bayesian"
      ],
      "description": "Inference family of a program."
    },
    "refusal": {
      "type": "object",
      "description": "A typed refusal. It names the registered code and, when known, what the caller can change to proceed. It is never a result.",
      "required": [
        "status",
        "family",
        "reason_code",
        "message"
      ],
      "properties": {
        "status": {
          "const": "unsupported"
        },
        "family": {
          "$ref": "#/$defs/error_family"
        },
        "reason_code": {
          "oneOf": [
            {
              "$ref": "#/$defs/refusal_code"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null only for a failure that is not a refusal (a malformed input, a resource limit, a cancellation); family still classifies it."
        },
        "message": {
          "type": "string"
        },
        "remedy": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "claim_domains": {
      "type": "object",
      "required": [
        "identification",
        "support",
        "evaluated"
      ],
      "properties": {
        "identification": {
          "$ref": "#/$defs/domain_status"
        },
        "support": {
          "$ref": "#/$defs/domain_status"
        },
        "evaluated": {
          "$ref": "#/$defs/domain_status"
        }
      },
      "additionalProperties": false
    },
    "claim_envelope": {
      "type": "object",
      "description": "Portable claim over a compiled contract and one execution. A claim of kind refusal or incomplete is a record, not a value.",
      "required": [
        "claim_id",
        "kind",
        "domains"
      ],
      "properties": {
        "claim_id": {
          "$ref": "#/$defs/digest"
        },
        "kind": {
          "$ref": "#/$defs/claim_kind"
        },
        "causal": {
          "type": "boolean",
          "description": "False for an associational claim: identification is not claimed, so the claim is never an intervention effect and is not counted as a causal one."
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        },
        "outcome_units": {
          "type": [
            "string",
            "null"
          ]
        },
        "domains": {
          "$ref": "#/$defs/claim_domains"
        },
        "execution": {
          "oneOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "$ref": "#/$defs/host_status"
        }
      },
      "additionalProperties": true
    },
    "contract_identities": {
      "type": "object",
      "description": "Domain-separated identities of a compiled contract. program is null before preparation: a structural inspection has not identified anything.",
      "required": [
        "target",
        "identification",
        "inference_binding",
        "observation"
      ],
      "properties": {
        "target": {
          "$ref": "#/$defs/digest"
        },
        "identification": {
          "$ref": "#/$defs/digest"
        },
        "identification_product": {
          "oneOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "program": {
          "oneOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        },
        "inference_binding": {
          "$ref": "#/$defs/digest"
        },
        "observation": {
          "$ref": "#/$defs/digest"
        },
        "data_snapshot": {
          "$ref": "#/$defs/digest"
        },
        "execution": {
          "oneOf": [
            {
              "$ref": "#/$defs/digest"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "causal_contract": {
      "type": "object",
      "description": "Immutable record of what was compiled: identities, structure, support status and the four reasoning slots (identification, support, uncertainty, assumptions). A slot is either available or states why it is not.",
      "required": [
        "identities",
        "graph_class",
        "structure_source",
        "query_kind"
      ],
      "properties": {
        "identities": {
          "$ref": "#/$defs/contract_identities"
        },
        "graph_class": {
          "$ref": "#/$defs/graph_class"
        },
        "structure_source": {
          "$ref": "#/$defs/structure_source"
        },
        "support_status": {
          "oneOf": [
            {
              "$ref": "#/$defs/support_cell_status"
            },
            {
              "type": "null"
            }
          ]
        },
        "query_kind": {
          "type": "string"
        },
        "inference": {
          "$ref": "#/$defs/inference"
        },
        "identifier": {
          "type": [
            "string",
            "null"
          ]
        },
        "estimator": {
          "type": [
            "string",
            "null"
          ]
        },
        "row_count": {
          "type": "integer",
          "minimum": 0
        },
        "modality": {
          "type": "string"
        },
        "reasoning": {
          "$ref": "#/$defs/reasoning"
        }
      },
      "additionalProperties": true
    },
    "reasoning_slot": {
      "type": "object",
      "required": [
        "available",
        "summary"
      ],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "type": "string"
        },
        "payload": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "reasoning": {
      "type": "object",
      "required": [
        "identification",
        "support",
        "uncertainty",
        "assumptions"
      ],
      "properties": {
        "identification": {
          "$ref": "#/$defs/reasoning_slot"
        },
        "support": {
          "$ref": "#/$defs/reasoning_slot"
        },
        "uncertainty": {
          "$ref": "#/$defs/reasoning_slot"
        },
        "assumptions": {
          "$ref": "#/$defs/reasoning_slot"
        }
      },
      "additionalProperties": true
    },
    "blocker": {
      "type": "object",
      "required": [
        "id",
        "reason",
        "scientific"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "scientific": {
          "type": "boolean",
          "description": "False for a budget, resource or cancellation blocker: it says nothing about whether the question can be answered."
        }
      },
      "additionalProperties": false
    },
    "next_action": {
      "type": "object",
      "required": [
        "id",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "licensed_neighbor": {
      "type": "object",
      "description": "A licensed alternative that changes named premises. An explicit choice for the caller, never an automatic fallback.",
      "required": [
        "coordinate",
        "changed",
        "required_action"
      ],
      "properties": {
        "coordinate": {
          "type": "string"
        },
        "changed": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "axis",
              "from",
              "to"
            ],
            "properties": {
              "axis": {
                "type": "string"
              },
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "required_action": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "unmet_obligation": {
      "type": "object",
      "description": "An obligation of the contract that is not yet resolved: a check that has not run or has failed.",
      "required": [
        "id",
        "scope",
        "kind",
        "status",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "required_check": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "operation_report": {
      "type": "object",
      "description": "Capability report for one operation, read before running it.",
      "required": [
        "operation",
        "applicability",
        "blockers",
        "next_actions"
      ],
      "properties": {
        "operation": {
          "$ref": "#/$defs/operation_kind"
        },
        "applicability": {
          "$ref": "#/$defs/semantic_applicability"
        },
        "readiness": {
          "oneOf": [
            {
              "$ref": "#/$defs/operation_readiness"
            },
            {
              "type": "null"
            }
          ]
        },
        "coordinate": {
          "type": [
            "string",
            "null"
          ]
        },
        "blockers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/blocker"
          }
        },
        "next_actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/next_action"
          }
        },
        "neighbors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/licensed_neighbor"
          }
        },
        "unmet_obligations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unmet_obligation"
          }
        },
        "status": {
          "$ref": "#/$defs/host_status"
        }
      },
      "additionalProperties": true
    },
    "fallback_unavailable": {
      "type": "object",
      "description": "A part of a descriptive fallback that is not provided, with the typed reason it is not. Absence is never silent.",
      "required": [
        "available",
        "part",
        "reason_code",
        "detail",
        "message"
      ],
      "properties": {
        "available": {
          "const": false
        },
        "part": {
          "enum": [
            "associational",
            "evidence_plan"
          ]
        },
        "reason_code": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "evidence_obligation": {
      "type": "object",
      "description": "Evidence an identification failure owes, with the proof step that derives it. An establish_assumption obligation is satisfiable by no study.",
      "required": [
        "id",
        "kind",
        "scope",
        "variables",
        "reason",
        "satisfiable_by_study"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "variables": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string"
        },
        "family": {
          "type": "string"
        },
        "proof_step": {
          "type": [
            "string",
            "null"
          ]
        },
        "satisfiable_by_study": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "fallback_response": {
      "type": "object",
      "description": "The opt-in descriptive fallback of an identification-class refusal. The causal question stays refused: status and causal_status are unsupported and refusal is the unchanged refusal. associational is a noncausal description of the observed law (claim.causal is false, it ranks no action, and it is not an answer to the causal question) or the typed reason there is none; evidence_plan carries the obligations, next actions and ranked plan or the typed reason there is none. associational_status shows the status of the noncausal claim beside the causal one.",
      "required": [
        "status",
        "causal_status",
        "associational_status",
        "refusal",
        "associational",
        "evidence_plan",
        "notice"
      ],
      "properties": {
        "status": {
          "const": "unsupported"
        },
        "causal_status": {
          "const": "unsupported"
        },
        "associational_status": {
          "oneOf": [
            {
              "$ref": "#/$defs/host_status"
            },
            {
              "const": "unavailable"
            }
          ]
        },
        "refusal": {
          "$ref": "#/$defs/refusal"
        },
        "associational": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "available",
                "noncausal",
                "ranks_actions",
                "claim"
              ],
              "properties": {
                "available": {
                  "const": true
                },
                "noncausal": {
                  "const": true
                },
                "ranks_actions": {
                  "const": false
                },
                "rule": {
                  "type": "string"
                },
                "claim": {
                  "$ref": "#/$defs/claim_envelope"
                }
              },
              "additionalProperties": false
            },
            {
              "$ref": "#/$defs/fallback_unavailable"
            }
          ]
        },
        "evidence_plan": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "available",
                "obligations",
                "next_actions",
                "ranked_plan"
              ],
              "properties": {
                "available": {
                  "const": true
                },
                "obligations": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/evidence_obligation"
                  }
                },
                "next_actions": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/next_action"
                  }
                },
                "ranked_plan": {
                  "type": "object"
                }
              },
              "additionalProperties": false
            },
            {
              "$ref": "#/$defs/fallback_unavailable"
            }
          ]
        },
        "notice": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "analysis_request": {
      "type": "object",
      "description": "What a host submits to compile an analysis. The query is named by its support-matrix label; its remaining members are that query's own parameters. Data stay in the host: a request carries column names or a data reference, not a callback.",
      "required": [
        "query"
      ],
      "properties": {
        "query": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "description": "A support-matrix query label, or the name of a route-specific query the host's version of the library documents.",
              "anyOf": [
                {
                  "$ref": "#/$defs/support_query"
                },
                {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9]*$"
                }
              ]
            }
          },
          "additionalProperties": true
        },
        "graph": {
          "type": "object",
          "properties": {
            "edges": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 2,
                "maxItems": 2
              }
            }
          },
          "additionalProperties": true
        },
        "data": {
          "type": "object",
          "properties": {
            "columns": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "reference": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "options": {
          "type": "object",
          "properties": {
            "inference": {
              "$ref": "#/$defs/inference"
            },
            "seed": {
              "type": "integer",
              "minimum": 0
            },
            "threads": {
              "type": "integer",
              "minimum": 0,
              "description": "0 lets the library choose; a positive value pins the study to that many worker threads."
            },
            "bootstrap": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "host_response": {
      "description": "What a host reads back for one request. Exactly one of claim or refusal is present. A claim of kind refusal, or one whose domain is contradicted, is carried as a claim with status unsupported.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "status",
            "claim"
          ],
          "properties": {
            "status": {
              "$ref": "#/$defs/host_status"
            },
            "claim": {
              "$ref": "#/$defs/claim_envelope"
            },
            "contract": {
              "$ref": "#/$defs/causal_contract"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "status",
            "refusal"
          ],
          "properties": {
            "status": {
              "const": "unsupported"
            },
            "refusal": {
              "$ref": "#/$defs/refusal"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "artifact_expectation": {
      "type": "object",
      "description": "What a consumer retains independently of the artifact bytes and supplies when loading. Container metadata never supplies it.",
      "properties": {
        "kind": {
          "type": "string"
        },
        "identities": {
          "type": "object"
        }
      },
      "additionalProperties": true
    }
  }
}
